<UserControl
    x:Class="NINA.Photon.Plugin.ASA.View.AxisMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localvm="clr-namespace:NINA.Photon.Plugin.ASA.ViewModels"
    xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Contrib.Wpf"
    d:DataContext="{d:DesignInstance localvm:AxisMonitor, IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>
    <Border
        Margin="2"
        Padding="4"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="2,0,0,4"
                FontSize="14"
                FontWeight="Bold"
                Foreground="{StaticResource PrimaryBrush}"
                Text="{Binding Title}" />

            <!--  Compact value readout: two columns of label/value pairs  -->
            <Grid Grid.Row="1" Margin="2,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource ValueLabel}"
                    Text="Current" />
                <TextBlock
                    Grid.Row="0" Grid.Column="1"
                    Foreground="#F6D94A"
                    Style="{StaticResource ValueText}"
                    Text="{Binding Current, StringFormat={}{0:0.000} A}" />

                <TextBlock
                    Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource ValueLabel}"
                    Text="Pos Error" />
                <TextBlock
                    Grid.Row="0" Grid.Column="3"
                    Foreground="#5CE1E6"
                    Style="{StaticResource ValueText}"
                    Text="{Binding PositionErrorArcsec, StringFormat={}{0:0.00}&#8243;}" />

                <TextBlock
                    Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource ValueLabel}"
                    Text="Enc Pos" />
                <TextBlock
                    Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource ValueText}"
                    Text="{Binding EncoderPositionDegrees, StringFormat={}{0:0.0000}&#176;}" />

                <TextBlock
                    Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource ValueLabel}"
                    Text="Velocity" />
                <TextBlock
                    Grid.Row="1" Grid.Column="3"
                    Foreground="#FF6FAE"
                    Style="{StaticResource ValueText}"
                    Text="{Binding VelocityDegreesPerSecond, StringFormat={}{0:0.0000}&#176;/s}" />

                <TextBlock
                    Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource ValueLabel}"
                    Text="Updated" />
                <TextBlock
                    Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                    HorizontalAlignment="Left"
                    Margin="0"
                    Style="{StaticResource ValueText}"
                    Text="{Binding LastUpdate, StringFormat={}{0:HH:mm:ss}}" />
            </Grid>

            <oxy:Plot
                Grid.Row="2"
                MinHeight="130"
                Background="Transparent"
                PlotAreaBackground="Transparent"
                PlotAreaBorderColor="Transparent">
                <oxy:Plot.Legends>
                    <oxy:Legend
                        LegendPlacement="Inside"
                        LegendPosition="TopRight"
                        LegendFontSize="10"
                        LegendBackground="#40000000"
                        LegendBorderThickness="0"
                        LegendTextColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                        LegendOrientation="Horizontal"
                        LegendMargin="0"
                        LegendPadding="2"
                        LegendSymbolLength="10" />
                </oxy:Plot.Legends>
                <oxy:Plot.Axes>
                    <oxy:LinearAxis
                        Position="Bottom"
                        Key="TimeAxis"
                        FontSize="10"
                        Unit="s"
                        IsPanEnabled="False"
                        IsZoomEnabled="False"
                        Maximum="0"
                        Minimum="{Binding TimeAxisMinimum}"
                        MajorGridlineStyle="Dot"
                        MinorGridlineStyle="None"
                        AxislineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                        MajorGridlineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}, Converter={StaticResource SetAlphaToColorConverter}, ConverterParameter=40}"
                        TextColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                        TicklineColor="{Binding Path=Color, Source={StaticResource SecondaryBrush}}" />
                    <oxy:LinearAxis
                        Position="Left"
                        Key="ErrorAxis"
                        FontSize="10"
                        IsPanEnabled="False"
                        IsZoomEnabled="False"
                        MajorGridlineStyle="Dot"
                        MinorGridlineStyle="None"
                        StringFormat="0.##"
                        AxislineColor="#5CE1E6"
                        MajorGridlineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}, Converter={StaticResource SetAlphaToColorConverter}, ConverterParameter=40}"
                        TextColor="#5CE1E6"
                        TicklineColor="#5CE1E6" />
                    <oxy:LinearAxis
                        Position="Right"
                        Key="CurrentAxis"
                        FontSize="10"
                        IsPanEnabled="False"
                        IsZoomEnabled="False"
                        MajorGridlineStyle="None"
                        MinorGridlineStyle="None"
                        StringFormat="0.##"
                        AxislineColor="#F6D94A"
                        TextColor="#F6D94A"
                        TicklineColor="#F6D94A" />
                    <oxy:LinearAxis
                        Position="Right"
                        PositionTier="1"
                        Key="VelocityAxis"
                        FontSize="10"
                        IsAxisVisible="{Binding IsChecked, ElementName=ShowVelocity}"
                        IsPanEnabled="False"
                        IsZoomEnabled="False"
                        MajorGridlineStyle="None"
                        MinorGridlineStyle="None"
                        StringFormat="0.###"
                        AxislineColor="#FF6FAE"
                        TextColor="#FF6FAE"
                        TicklineColor="#FF6FAE" />
                </oxy:Plot.Axes>
                <oxy:Plot.Series>
                    <oxy:LineSeries
                        Title="Err [&#8243;]"
                        ItemsSource="{Binding PositionErrorHistory, UpdateSourceTrigger=PropertyChanged}"
                        DataFieldX="X"
                        DataFieldY="Y"
                        XAxisKey="TimeAxis"
                        YAxisKey="ErrorAxis"
                        StrokeThickness="1.5"
                        Color="#5CE1E6"
                        TrackerFormatString="{}{0}&#x0a;{2:0.00}&#8243; @ {4:0}s" />
                    <oxy:LineSeries
                        Title="I [A]"
                        ItemsSource="{Binding CurrentHistory, UpdateSourceTrigger=PropertyChanged}"
                        DataFieldX="X"
                        DataFieldY="Y"
                        XAxisKey="TimeAxis"
                        YAxisKey="CurrentAxis"
                        StrokeThickness="1.5"
                        Color="#F6D94A"
                        TrackerFormatString="{}{0}&#x0a;{2:0.000} A @ {4:0}s" />
                    <oxy:LineSeries
                        Title="v [&#176;/s]"
                        ItemsSource="{Binding VelocityHistory, UpdateSourceTrigger=PropertyChanged}"
                        DataFieldX="X"
                        DataFieldY="Y"
                        XAxisKey="TimeAxis"
                        YAxisKey="VelocityAxis"
                        StrokeThickness="1.5"
                        Color="#FF6FAE"
                        Visibility="{Binding IsChecked, ElementName=ShowVelocity, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}"
                        TrackerFormatString="{}{0}&#x0a;{2:0.0000}&#176;/s @ {4:0}s" />
                </oxy:Plot.Series>
            </oxy:Plot>

            <CheckBox
                x:Name="ShowVelocity"
                Grid.Row="2"
                Margin="0,0,4,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Content="v"
                IsChecked="True"
                ToolTip="Show velocity series" />
        </Grid>
    </Border>
</UserControl>
