<UserControl
    x:Class="NINA.Photon.Plugin.ASA.View.AxisMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NINA.Photon.Plugin.ASA.View"
    xmlns:localvm="clr-namespace:NINA.Photon.Plugin.ASA.ViewModels"
    xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Contrib.Wpf"
    d:DataContext="{d:DesignInstance localvm:AxisMonitor, IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>
    <Border
        Margin="2"
        Padding="6,4,6,4"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Title row with the velocity series toggle  -->
            <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="False">
                <TextBlock
                    DockPanel.Dock="Left"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryBrush}"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis" />
                <CheckBox
                   DockPanel.Dock="Right"
                   VerticalAlignment="Center"
                   IsChecked="{Binding ShowCurrent, Mode=TwoWay}"
                   ToolTip="Show current series" />
                <TextBlock
                   DockPanel.Dock="Right"
                   Margin="0,0,6,0"
                   VerticalAlignment="Center"
                   FontSize="10"
                   Foreground="#F6D94A"
                   Text="current"
                   ToolTip="Show current series" />
                <CheckBox
                   DockPanel.Dock="Right"
                   VerticalAlignment="Center"
                   IsChecked="{Binding ShowVelocity, Mode=TwoWay}"
                   ToolTip="Show velocity series" />
                <TextBlock
                   DockPanel.Dock="Right"
                   Margin="0,0,6,0"
                   VerticalAlignment="Center"
                   FontSize="10"
                   Foreground="#FF6FAE"
                   Text="velocity"
                   ToolTip="Show velocity series" />
            </DockPanel>

            <!--  Value readout: each metric is a stacked label/value chip so nothing overlaps  -->
            <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,0,0,4">
                <StackPanel Margin="0,0,6,2">
                    <TextBlock Style="{StaticResource ValueLabel}" Text="Current" />
                    <TextBlock
                        Foreground="#F6D94A"
                        Style="{StaticResource ValueText}"
                        Text="{Binding Current, StringFormat={}{0:0.000} A}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,2">
                    <TextBlock Style="{StaticResource ValueLabel}" Text="Pos Error" />
                    <TextBlock
                        Foreground="#5CE1E6"
                        Style="{StaticResource ValueText}"
                        Text="{Binding PositionErrorArcsec, StringFormat={}{0:0.000}&#8243;}" />
                </StackPanel>
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Style="{StaticResource ValueLabel}" Text="Velocity" />
                    <TextBlock
                        Foreground="#FF6FAE"
                        Style="{StaticResource ValueText}"
                        Text="{Binding VelocityArcsecPerSecond, StringFormat={}{0:0.00}&#8243;/s}"
                        ToolTip="Axis velocity. Sidereal tracking is about 15.04&#8243;/s" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource ValueLabel}" Text="Enc Pos" />
                    <TextBlock
                        Foreground="{StaticResource PrimaryBrush}"
                        Style="{StaticResource ValueText}"
                        Text="{Binding EncoderPositionDegrees, StringFormat={}{0:0.000}&#176;}"
                        ToolTip="{Binding LastUpdate, StringFormat=Last update: {0:HH:mm:ss}}" />
                </StackPanel>
            </UniformGrid>

            <!--  Rolling max / trailing average / RMS deviation of the position error  -->
            <Border
                Grid.Row="2"
                Margin="0,0,0,4"
                Padding="4,2,4,2"
                Background="{StaticResource TertiaryBackgroundBrush}"
                CornerRadius="2">
                <local:ErrorStatisticsView DataContext="{Binding ErrorStatistics}" />
            </Border>

            <oxy:Plot
                Grid.Row="4"
                MinHeight="130"
                Background="Transparent"
                PlotAreaBackground="Transparent"
                PlotAreaBorderColor="Transparent">
                <oxy:Plot.Axes>
                    <oxy:LinearAxis
                        Position="Bottom"
                        Key="TimeAxis"
                        FontSize="10"
                        IntervalLength="40"
                        Unit="s"
                        IsPanEnabled="False"
                        IsZoomEnabled="False"
                        Maximum="0"
                        Minimum="{Binding TimeAxisMinimum}"
                        MajorGridlineStyle="Dot"
                        MinorGridlineStyle="None"
                        AxislineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                        MajorGridlineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}, Converter={StaticResource SetAlphaToColorConverter}, ConverterParameter=40}"
                        TextColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}}"
                        TicklineColor="{Binding Path=Color, Source={StaticResource SecondaryBrush}}" />
                    <oxy:LinearAxis
                        Position="Left"
                        Key="ErrorAxis"
                        FontSize="10"
                        Minimum="{Binding ErrorAxisMinimum}"
                        Maximum="{Binding ErrorAxisMaximum}"
                        IntervalLength="28"
                        IsPanEnabled="False"
                        IsZoomEnabled="False"
                        MajorGridlineStyle="Dot"
                        MinorGridlineStyle="None"
                        StringFormat="0.###"
                        AxislineColor="#5CE1E6"
                        MajorGridlineColor="{Binding Path=Color, Source={StaticResource PrimaryBrush}, Converter={StaticResource SetAlphaToColorConverter}, ConverterParameter=40}"
                        TextColor="#5CE1E6"
                        TicklineColor="#5CE1E6" />
                    <oxy:LinearAxis
                        Position="Right"
                        Key="CurrentAxis"
                        FontSize="10"
                        IntervalLength="34"
                        AxisTitleDistance="0"
                        IsAxisVisible="{Binding ShowCurrent}"
                        IsPanEnabled="False"
                        IsZoomEnabled="False"
                        MajorGridlineStyle="None"
                        MinorGridlineStyle="None"
                        StringFormat="0.##"
                        AxislineColor="#F6D94A"
                        TextColor="#F6D94A"
                        TicklineColor="#F6D94A" />
                    <oxy:LinearAxis
                        Position="Right"
                        PositionTier="1"
                        Key="VelocityAxis"
                        FontSize="10"
                        IntervalLength="34"
                        AxisTitleDistance="0"
                        IsAxisVisible="{Binding ShowVelocity}"
                        IsPanEnabled="False"
                        IsZoomEnabled="False"
                        MajorGridlineStyle="None"
                        MinorGridlineStyle="None"
                        StringFormat="0.##"
                        AxislineColor="#FF6FAE"
                        TextColor="#FF6FAE"
                        TicklineColor="#FF6FAE" />
                    <!--  Fixed 0..1 scale so epoch markers and exposure shading span the full plot height  -->
                    <oxy:LinearAxis
                        Position="Left"
                        Key="EpochAxis"
                        Minimum="0"
                        Maximum="1"
                        IsAxisVisible="False"
                        IsPanEnabled="False"
                        IsZoomEnabled="False"
                        MajorGridlineStyle="None"
                        MinorGridlineStyle="None" />
                    <oxy:LinearColorAxis
                        Position="Right"
                        Key="ExposureColorAxis"
                        Minimum="0"
                        Maximum="1"
                        LowColor="#14F6D94A"
                        HighColor="#14F6D94A"
                        IsAxisVisible="False" />
                </oxy:Plot.Axes>
                <oxy:Plot.Series>
                    <oxy:RectangleSeries
                        ItemsSource="{Binding ExposureBackgrounds, UpdateSourceTrigger=PropertyChanged}"
                        XAxisKey="TimeAxis"
                        YAxisKey="EpochAxis"
                        ColorAxisKey="ExposureColorAxis"
                        RenderInLegend="False"
                        TrackerFormatString="{}{Title}" />
                    <!--  Vertical line marking the start of a new statistics epoch  -->
                    <oxy:LineSeries
                        ItemsSource="{Binding EpochMarkerSeries, UpdateSourceTrigger=PropertyChanged}"
                        DataFieldX="X"
                        DataFieldY="Y"
                        XAxisKey="TimeAxis"
                        YAxisKey="EpochAxis"
                        StrokeThickness="1"
                        LineStyle="Dash"
                        Color="#9AA6B2"
                        RenderInLegend="False"
                        TrackerFormatString="{}New statistics epoch" />
                    <oxy:LineSeries
                        Title="Err [&#8243;]"
                        ItemsSource="{Binding PositionErrorHistory, UpdateSourceTrigger=PropertyChanged}"
                        DataFieldX="X"
                        DataFieldY="Y"
                        XAxisKey="TimeAxis"
                        YAxisKey="ErrorAxis"
                        StrokeThickness="1.5"
                        Color="#5CE1E6"
                        TrackerFormatString="{}{0}&#x0a;{2:0.000}&#8243; @ {4:0}s" />
                    <oxy:LineSeries
                        Title="I [A]"
                        ItemsSource="{Binding CurrentHistory, UpdateSourceTrigger=PropertyChanged}"
                        DataFieldX="X"
                        DataFieldY="Y"
                        XAxisKey="TimeAxis"
                        YAxisKey="CurrentAxis"
                        StrokeThickness="1.5"
                        Color="#F6D94A"
                        Visibility="{Binding ShowCurrent, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}"
                        TrackerFormatString="{}{0}&#x0a;{2:0.000} A @ {4:0}s" />
                    <oxy:LineSeries
                        Title="v [&#8243;/s]"
                        ItemsSource="{Binding VelocityHistory, UpdateSourceTrigger=PropertyChanged}"
                        DataFieldX="X"
                        DataFieldY="Y"
                        XAxisKey="TimeAxis"
                        YAxisKey="VelocityAxis"
                        StrokeThickness="1.5"
                        Color="#FF6FAE"
                        Visibility="{Binding ShowVelocity, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}"
                        TrackerFormatString="{}{0}&#x0a;{2:0.00}&#8243;/s @ {4:0}s" />
                </oxy:Plot.Series>
            </oxy:Plot>
        </Grid>
    </Border>
</UserControl>
