<UserControl
    x:Class="NINA.Photon.Plugin.ASA.View.MountInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NINA.Photon.Plugin.ASA.View"
    xmlns:localvm="clr-namespace:NINA.Photon.Plugin.ASA.ViewModels"
    d:DataContext="{d:DesignInstance localvm:MountInfoVM, IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!--  Toolbar: monitoring toggle, graph width and mount refresh rate  -->
        <Grid Grid.Row="0" Margin="4,2,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox
                Grid.Column="0"
                VerticalAlignment="Center"
                IsChecked="{Binding MonitoringEnabled, Mode=TwoWay}"
                ToolTip="Enable or disable polling of the mount axis reports" />
            <TextBlock
                Grid.Column="1"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource PrimaryBrush}"
                Text="Monitor"
                ToolTip="Enable or disable polling of the mount axis reports" />

            <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource PrimaryBrush}"
                    Opacity="0.85"
                    Text="History" />
                <ComboBox
                    Margin="6,0,0,0"
                    MinWidth="64"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding HistoryChoices}"
                    SelectedItem="{Binding HistorySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Width of the graphs in seconds">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0} s}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="3" Margin="12,0,0,0" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource PrimaryBrush}"
                    Opacity="0.85"
                    Text="Rate" />
                <ComboBox
                    Margin="6,0,0,0"
                    MinWidth="64"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding RefreshIntervalChoices}"
                    SelectedItem="{Binding RefreshIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Mount report refresh interval in seconds">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0} s}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="4,0,4,4">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource PrimaryBrush}"
                Opacity="0.8"
                Text="Telescope not connected"
                Visibility="{Binding TelescopeConnected, Converter={StaticResource InverseBooleanToVisibilityCollapsedConverter}}" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                FontWeight="Bold"
                Foreground="#F6D94A"
                Text="Slewing - statistics paused"
                Visibility="{Binding StatisticsPaused, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
            <TextBlock
                FontSize="11"
                Foreground="{StaticResource NotificationErrorBrush}"
                Text="{Binding ErrorMessage}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ToolTip="{Binding ErrorMessage}" />
        </StackPanel>

        <!--  Combined (both axes) position error statistics  -->
        <Border
            Grid.Row="2"
            Margin="6,0,6,4"
            Padding="6,3,6,4"
            Background="{StaticResource TertiaryBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="3">
            <StackPanel>
                <DockPanel Margin="0,0,0,2" LastChildFill="False">
                    <TextBlock
                        DockPanel.Dock="Left"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="Total" />
                    <TextBlock
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="#5CE1E6"
                        Text="{Binding TotalErrorArcsec, StringFormat={}{0:0.000}&#8243;}"
                        ToolTip="Current combined position error of both axes" />
                </DockPanel>
                <local:ErrorStatisticsView DataContext="{Binding TotalErrorStatistics}" />
            </StackPanel>
        </Border>

        <local:AxisMonitorView Grid.Row="3" DataContext="{Binding Axis1}" />
        <local:AxisMonitorView Grid.Row="4" DataContext="{Binding Axis2}" />
    </Grid>
</UserControl>
