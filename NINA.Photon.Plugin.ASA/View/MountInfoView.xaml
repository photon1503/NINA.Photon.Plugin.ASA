<UserControl
    x:Class="NINA.Photon.Plugin.ASA.View.MountInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NINA.Photon.Plugin.ASA.View"
    xmlns:localvm="clr-namespace:NINA.Photon.Plugin.ASA.ViewModels"
    d:DataContext="{d:DesignInstance localvm:MountInfoVM, IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!--  History selector  -->
        <StackPanel
            Grid.Row="0"
            Margin="4,2,4,4"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Opacity="0.7"
                Text="History" />
            <ComboBox
                Margin="6,0,4,0"
                MinWidth="70"
                VerticalAlignment="Center"
                ItemsSource="{Binding HistoryChoices}"
                SelectedItem="{Binding HistorySeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Width of the graphs in seconds">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat={}{0} s}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Margin="8,0,0,0"
                Opacity="0.7"
                Text="Rate" />
            <ComboBox
                Margin="6,0,4,0"
                MinWidth="70"
                VerticalAlignment="Center"
                ItemsSource="{Binding RefreshIntervalChoices}"
                SelectedItem="{Binding RefreshIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Mount report refresh interval in seconds">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat={}{0} s}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{StaticResource NotificationErrorBrush}"
                Text="{Binding ErrorMessage}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding ErrorMessage}" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Margin="4,4,4,4"
            HorizontalAlignment="Center"
            Opacity="0.7"
            Text="Telescope not connected"
            Visibility="{Binding TelescopeConnected, Converter={StaticResource InverseBooleanToVisibilityCollapsedConverter}}" />

        <local:AxisMonitorView Grid.Row="2" DataContext="{Binding Axis1}" />
        <local:AxisMonitorView Grid.Row="3" DataContext="{Binding Axis2}" />
    </Grid>
</UserControl>
